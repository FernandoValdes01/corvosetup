{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "@HOME@/.agents/skills"
    ]
  },
  "permission": {
    "skill": {
      "*": "allow",
      "quality-agents": "deny"
    }
  },
  "mcp": {
    "filmcraft": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-filmcraft"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "packet-tracer": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-packet-tracer"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "jflap": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-jflap"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "drawio": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-drawio"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "photocraft": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-photocraft"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "scrapling": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-scrapling"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "firefox-local": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-firefox-local"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "youtube-research": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-youtube-research"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "lightcraft": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-lightcraft"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "lightcraft-app": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-lightcraft-app"
      ],
      "enabled": true,
      "timeout": 10000
    }
  }
}
