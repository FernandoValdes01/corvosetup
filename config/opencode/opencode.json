{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "@HOME@/.agents/skills"
    ]
  },
  "permission": {
    "skill": {
      "*": "allow",
      "quality-agents": "deny"
    }
  },
  "mcp": {
    "filmcraft": {
      "type": "local",
      "command": ["@HOME@/.local/bin/corvosetup-mcp-filmcraft"],
      "enabled": true,
      "timeout": 10000
    },
    "packet-tracer": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-packet-tracer"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "jflap": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-jflap"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "drawio": {
      "type": "local",
      "command": [
        "@HOME@/.local/bin/corvosetup-mcp-drawio"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    }
  }
}
